    "item-1-title": {
      "type": "Heading",
      "props": {
        "text": "starknet.js v11.7 prerelease adds STRK20 wallet registration",
        "level": "h3"
      },
      "children": []
    },
    "item-1-desc": {
      "type": "Text",
      "props": {
        "text": "The prerelease supports Wallet API 0.10.5, letting a supporting wallet register a Cairo account in the STRK20 privacy pool. The register action must be the only action in its request."
      },
      "children": []
    },
    "item-1-why": {
      "type": "Text",
      "props": {
        "text": "Why it matters: dApps can now onboard users into shielded balances through the wallet flow instead of custom plumbing."
      },
      "children": []
    },
