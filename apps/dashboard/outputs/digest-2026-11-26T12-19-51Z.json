    "item-2-title": {
      "type": "Heading",
      "props": {
        "text": "Starknet.Build opens a waitlist for its AI app builder",
        "level": "h3"
      },
      "children": []
    },
    "item-2-desc": {
      "type": "Text",
      "props": {
        "text": "Describe an app in plain language and it writes the contracts, builds the frontend, runs tests, and deploys to Starknet. It is in private beta, with no public launch date on the site, and is built on the privacy features (STRK20, shielded transfers)."
      },
      "children": []
    },
    "item-2-why": {
      "type": "Text",
      "props": {
        "text": "Why it matters: a no-Cairo path to shipping privacy apps; join the waitlist if you want early access."
      },
      "children": []
