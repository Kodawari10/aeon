      "type": "Text",
      "props": {
        "text": "monitor-polymarket ran with both watchlists empty, so nothing was tracked. Kalshi's default open-events feed has no 24h volume data and lists only long-dated markets such as Mars by 2050, the next Pope and supervolcanoes, so no report was generated.",
        "variant": "body"
      },
      "children": []
    },
    "sep": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
