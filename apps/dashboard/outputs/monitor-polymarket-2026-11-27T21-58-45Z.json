      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading",
        "poly",
        "kalshi"
      ]
    },
    "heading": {
      "type": "Heading",
      "props": {
        "text": "To enable monitoring",
        "level": "h3"
      },
      "children": []
    },
    "poly": {
      "type": "Text",
      "props": {
        "text": "Add Polymarket event slugs to skills/monitor-polymarket/watchlist-polymarket.md, one per line",
